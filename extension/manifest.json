{
  "manifest_version": 3,
  "name": "MakerCode AI",
  "version": "1.0.0",
  "description": "Plan, wire, code and debug Arduino, ESP32 and micro:bit projects while you work in MakeCode or the Arduino IDE.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MakerCode AI",
    "default_icon": {
      "16": "../icons/icon-192.png",
      "48": "../icons/icon-192.png",
      "128": "../icons/icon-512.png"
    }
  },
  "icons": {
    "16": "../icons/icon-192.png",
    "48": "../icons/icon-192.png",
    "128": "../icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
